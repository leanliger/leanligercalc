{
  "name": "prep-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Fat Loss Timeline & Carb Cycling calculators for contest prep and body recomposition.",
  "scripts": {
    "dev": "node scripts/copy-zxing.mjs && next dev",
    "build": "node scripts/copy-zxing.mjs && next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "dev:worker": "npm run build:static && wrangler d1 migrations apply leanligercalc --local && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply leanligercalc --remote",
    "deploy": "npm run build:static && wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "wrangler": "^4.145.0"
  }
}
