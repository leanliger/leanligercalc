{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts", "../src/lib/tracking.ts", "../src/lib/dates.ts", "../src/lib/habits.ts", "../src/lib/reviews.ts", "../src/lib/food.ts", "../src/lib/fasting.ts", "../src/lib/coach-api.ts"]
}
